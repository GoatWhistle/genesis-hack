# Блок для существующего Caddy.
#
# ПОДСТАВЬТЕ СВОЙ ДОМЕН вместо rsocket.example.com в строке ниже — это
# единственное место в файле, которое зависит от площадки. Для проверки на
# машине разработчика замените домен на :8080 (тогда Caddy не пойдёт за
# сертификатом) и верните обратно перед выкладкой.
#
# Один origin на сайт и API: статика с корня, сервис под /api. Так нет CORS,
# нет отдельной выдачи сертификата и нет разницы между разработкой и продом —
# в разработке то же самое делает прокси Vite.

rsocket.example.com {
	encode zstd gzip

	# API сервиса. Путь /api/* снимается: сервис про него не знает.
	handle_path /api/* {
		# Тело описания ограничено 8 МиБ самим сервисом — не пропускаем больше
		# и мы, чтобы отказ приходил до чтения тела.
		#
		# Именно 8MiB, а не 8MB: Caddy считает MB десятичным (8 000 000), и с
		# ним наш предел оказался бы строже сервисного — описание размером
		# между 8 000 000 и 8 388 608 байт сервис принял бы, а Caddy отверг.
		request_body {
			max_size 8MiB
		}

		# У сервиса нет ни авторизации, ни ограничения частоты — так написано в
		# его собственной документации. Запись правил наружу закрыта: испорченные
		# правила ломают не запись, а следующую сборку у всех.
		#
		# Матчер @rules сверяет путь уже без префикса /api: handle_path снял его
		# выше, поэтому здесь /rules/*, а не /api/rules/*.
		@rules path /rules/*
		handle @rules {
			@write method PUT POST DELETE
			handle @write {
				respond "запись правил закрыта снаружи" 403
			}
			reverse_proxy rsocket:9292
		}

		reverse_proxy rsocket:9292
	}

	# Статика сайта. Хеши в именах файлов — значит содержимое неизменяемо и
	# кешируется навсегда; index.html не кешируется, иначе выкладка не видна.
	handle {
		# current — симлинк на каталог текущего выпуска, его переключает
		# выкладка. Смонтирован родитель /srv/rsocket, а не сам каталог со
		# статикой: bind-том держится за inode, и подмена каталога прошла бы
		# мимо контейнера. Подробности — в compose.prod.yaml.
		root * /srv/rsocket/current

		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		# no-cache вешаем на всё, что не /assets/*, а не на путь /index.html:
		# матчер пути сверяет адрес запроса, а его-то как раз и не существует —
		# посетитель приходит на / или на /lab/..., и index.html ему отдаёт
		# try_files. По пути /index.html никто не ходит, поэтому заголовок с
		# таким матчером не доставался никому, и браузер кешировал разметку по
		# своему усмотрению: после выкладки люди видели старую сборку.
		@html not path /assets/*
		header @html Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
