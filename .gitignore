.DS_Store

# Установленные гемы и сборки
/.bundle/
/vendor/bundle
*.gem
/pkg/

# Рабочие каталоги
/coverage/
/tmp/

# Результат работы инструмента — временный, сам каталог нужен всегда
/output/*
!/output/.keep

# Список упавших примеров для `rspec --only-failures`, у каждого свой
.rspec_status

# Gemfile.lock не игнорируется намеренно: это приложение-инструмент, а не
# библиотека. Лок в репозитории — гарантия, что у всей команды и у жюри
# ставятся ровно те же версии гемов.

desc.docx
rsocket-how-it-works.pdf
# Только описание в корне репозитория.
/provider_api.yaml

# Витрина web/: зависимости, сборка и рабочие снимки экрана
/web/node_modules/
/web/dist/
/web/.vite/
/web/.shots/
/web/src/api/schema.d.ts

# Playwright складывает трассы туда, откуда запущен
.playwright-mcp/

# Снимки экрана и дампы страниц: место им в web/.shots/, но иногда падают в корень
/*.png
/*.jpeg
/*.webp
/*.yml
!/compose.yaml

# Замеры целиком: чужие описания API (часть без лицензии, вместе — 17 МБ),
# скрипты и результаты прогонов. Что откуда взято — в bench/specs/SOURCES.md,
# качает всё bench/fetch_specs.sh.
/bench/

# Смысловые классификаторы — работа на пробу: каждому нужен внешний сервис и ключ
# к нему. Сборка обязана идти без сети, поэтому в репозиторий они не едут, а
# инструмент подхватывает их, только если файлы лежат рядом (см. Rsocket::OPTIONAL).
# Здесь же их проверки и подставные внешние сервисы для них.
/app/adapter/embedding/
/app/adapter/classification/embeddings.rb
/app/adapter/classification/llm.rb
/app/adapter/classification/llm/
/spec/adapter/embedding/
/spec/adapter/classification/
/spec/support/classification.rb
