.DS_Store

# Установленные гемы и сборки
/.bundle/
/vendor/bundle
*.gem
/pkg/

# Рабочие каталоги
/coverage/
/tmp/

# Результат работы инструмента — временный, сам каталог нужен всегда
/output/*
!/output/.keep

# Список упавших примеров для `rspec --only-failures`, у каждого свой
.rspec_status

# Gemfile.lock не игнорируется намеренно: это приложение-инструмент, а не
# библиотека. Лок в репозитории — гарантия, что у всей команды и у жюри
# ставятся ровно те же версии гемов.

desc.docx
rsocket-how-it-works.pdf
# Только описание в корне репозитория. Без ведущей косой черты правило глушило
# любой provider_api.yaml на любой глубине — в том числе bench/unseen/, который
# нужен замеру и должен лежать в репозитории.
/provider_api.yaml

# Витрина web/: зависимости, сборка и рабочие снимки экрана
/web/node_modules/
/web/dist/
/web/.vite/
/web/.shots/
/web/src/api/schema.d.ts

# Playwright складывает трассы туда, откуда запущен
.playwright-mcp/

# Снимки экрана и дампы страниц: место им в web/.shots/, но иногда падают в корень
/*.png
/*.jpeg
/*.webp
/*.yml
!/compose.yaml

# Описания чужих API, скачанные для замеров: часть без лицензии, вместе — 17 МБ.
# Что откуда взято и на каких условиях — в bench/specs/SOURCES.md, качает всё
# bench/fetch_specs.sh.
/bench/specs/*
!/bench/specs/SOURCES.md
